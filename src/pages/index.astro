---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/secciones/Hero.astro';
import Resumen from '../components/secciones/Resumen.astro';
import Metafora from '../components/secciones/Metafora.astro';
import QuienSoy from '../components/secciones/QuienSoy.astro';
import MarcoClinico from '../components/secciones/MarcoClinico.astro';
import ComoTrabajo from '../components/secciones/ComoTrabajo.astro';
import Servicios from '../components/secciones/Servicios.astro';
import Pertinencia from '../components/secciones/Pertinencia.astro';
import Proceso from '../components/secciones/Proceso.astro';
import Recursos from '../components/secciones/Recursos.astro';
import Faq from '../components/secciones/Faq.astro';
import Agenda from '../components/secciones/Agenda.astro';
import Instagram from '../components/secciones/Instagram.astro';
import BarraMovil from '../components/BarraMovil.astro';

/**
 * Catálogo de la práctica para el schema de la home. Refleja los precios
 * visibles en la sección de servicios; si cambia uno allá, cambia aquí.
 */
const catalogo = {
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios clínicos',
    itemListElement: [
      ['Evaluación Funcional Clínica', 'Proceso estructurado de 3 sesiones, con análisis funcional e informe', '390000', 'psicologo-infantil-bogota'],
      ['Evaluación del espectro autista · ADOS-2 / ADI-R', '6 sesiones, incluye protocolos', '1050000', 'evaluacion-autismo-ados-2-bogota'],
      ['Programa de Intervención Individual · niñez y adolescencia', '16 sesiones, 4 sesiones con cuidadores y una asesoría al colegio', '2750000', 'psicologo-infantil-bogota'],
      ['Programa de Intervención Individual · jóvenes adultos', 'Ciclo de 16 sesiones con criterios de cierre', '2080000', 'psicologo-jovenes-adultos-bogota'],
      ['Entrenamiento conductual a cuidadores', 'Ciclo de 8 sesiones con práctica en vivo y registro diario', '1040000', 'psicologo-infantil-bogota'],
      ['PEERS · Habilidades sociales', 'Ciclo de 14 sesiones en grupo, por adolescente', '1400000', 'peers-adolescentes-bogota'],
      ['Coaching parental', 'Sesiones con cuidadores, número acordado en la llamada', '130000', ''],
    ].map(([nombre, desc, precio, slug]) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: nombre,
        description: desc,
        ...(slug && { url: `https://davidflorez.co/${slug}/` }),
      },
      price: precio,
      priceCurrency: 'COP',
    })),
  },
};
---

<BaseLayout extraPractica={catalogo}>
  <Hero />
  <Resumen />
  <Pertinencia />
  <Metafora />
  <QuienSoy />
  <MarcoClinico />
  <ComoTrabajo />
  <Servicios />
  <Proceso />
  <Recursos />
  <Faq />
  <Agenda />
  <Instagram />
  <BarraMovil />
</BaseLayout>
