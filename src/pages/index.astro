---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/secciones/Hero.astro';
import Resumen from '../components/secciones/Resumen.astro';
import Metafora from '../components/secciones/Metafora.astro';
import QuienSoy from '../components/secciones/QuienSoy.astro';
import MarcoClinico from '../components/secciones/MarcoClinico.astro';
import ComoTrabajo from '../components/secciones/ComoTrabajo.astro';
import Servicios from '../components/secciones/Servicios.astro';
import Pertinencia from '../components/secciones/Pertinencia.astro';
import Proceso from '../components/secciones/Proceso.astro';
import Recursos from '../components/secciones/Recursos.astro';
import Faq from '../components/secciones/Faq.astro';
import Agenda from '../components/secciones/Agenda.astro';
import Instagram from '../components/secciones/Instagram.astro';
import BarraMovil from '../components/BarraMovil.astro';
import { PESTANAS } from '../data/servicios';
import { paginaDeServicio, precioNumerico } from '../data/paginas-servicio';

/**
 * Catálogo de la práctica para el schema de la home. Se deriva de las mismas
 * tarjetas que se ven en la sección de servicios, así los precios no pueden
 * desincronizarse. Solo entran servicios con un precio único.
 */
const vistos = new Set<string>();
const catalogo = {
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios clínicos',
    itemListElement: PESTANAS.flatMap((p) => p.servicios)
      .filter((s) => {
        const clave = `${s.titulo}|${s.precio}`;
        if (!precioNumerico(s.precio) || vistos.has(clave)) return false;
        vistos.add(clave);
        return true;
      })
      .map((s) => {
        const pagina = paginaDeServicio(s.id);
        return {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: s.titulo,
            description: s.notaPrecio ? `${s.desc} (${s.notaPrecio})` : s.desc,
            ...(pagina && { url: `https://davidflorez.co/${pagina.slug}/` }),
          },
          price: precioNumerico(s.precio),
          priceCurrency: 'COP',
        };
      }),
  },
};
---

<BaseLayout extraPractica={catalogo}>
  <Hero />
  <Resumen />
  <Pertinencia />
  <Metafora />
  <QuienSoy />
  <MarcoClinico />
  <ComoTrabajo />
  <Servicios />
  <Proceso />
  <Recursos />
  <Faq />
  <Agenda />
  <Instagram />
  <BarraMovil />
</BaseLayout>
