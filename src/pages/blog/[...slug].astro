---
/**
 * Página de artículo.
 *
 * Los borradores (draft: true) se ven en `npm run dev` para poder revisarlos,
 * y no se generan en el build de producción hasta que David los apruebe.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { CAL_COM } from '../../data/contacto';
import { ID_PERSONA, ID_PRACTICA, NOMBRE_COMPLETO, TARJETA_PROFESIONAL } from '../../data/identidad';
import { paginaPorSlug } from '../../data/paginas-servicio';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || data.draft !== true);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const categoria = post.data.tags?.[0] ?? 'Artículo';
const formatoFecha = (d: Date) =>
  d.toLocaleDateString('es-CO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    // La fecha del frontmatter es medianoche UTC: sin esto, en Colombia
    // (UTC-5) se muestra el dia anterior.
    timeZone: 'UTC',
  });
const fecha = formatoFecha(post.data.pubDate);
const revisado = post.data.updatedDate;

/** Lectura estimada a 200 palabras por minuto, redondeada hacia arriba. */
const palabras = post.body.split(/\s+/).filter(Boolean).length;
const minutos = Math.max(1, Math.ceil(palabras / 200));

const siteUrl = Astro.site ?? 'https://davidflorez.co';
const urlArticulo = new URL(`/blog/${post.slug}/`, siteUrl).href;
const schema = [
  {
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    ...(revisado && { dateModified: revisado.toISOString() }),
    inLanguage: 'es-CO',
    keywords: post.data.tags?.join(', '),
    wordCount: palabras,
    mainEntityOfPage: urlArticulo,
    image: new URL('/og-image.png', siteUrl).href,
    author: { '@id': ID_PERSONA },
    publisher: { '@id': ID_PRACTICA },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', siteUrl).href },
      { '@type': 'ListItem', position: 2, name: 'Artículos', item: new URL('/blog/', siteUrl).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: urlArticulo },
    ],
  },
];

const servicio = post.data.servicio ? paginaPorSlug(post.data.servicio) : undefined;

/** Enlaces de vuelta a la home, según a quién le habla el artículo. */
const paraColegas = categoria.toLowerCase().includes('colega');
const relacionados = paraColegas
  ? [
      ['/#marco', 'El marco clínico: terapia basada en procesos'],
      ['/#como-trabajo', 'Cómo trabajo: hipótesis, datos y criterios de cierre'],
      ['/#servicios', 'Servicios y condiciones de ingreso'],
    ]
  : [
      ...(servicio ? [[`/${servicio.slug}/`, `${servicio.nombre}: qué incluye, precio y cómo empezar`]] : []),
      ['/#pertinencia', '¿Es mi caso? Cuatro preguntas para saberlo'],
      ['/#servicios', 'Servicios, precios y qué incluye cada uno'],
      ['/#faq', 'Preguntas frecuentes'],
    ];
---

<BaseLayout title={`${post.data.title} — David Flórez`} description={post.data.description} schema={schema}>
  <article class="articulo">
    <div class="cabeza">
      <div class="rotulo">
        <a href="/blog/" class="volver">← Artículos</a>
        <span class="categoria">{categoria}</span>
      </div>

      <h1>{post.data.title}</h1>
      <p class="bajada">{post.data.description}</p>

      <p class="datos">
        <time datetime={post.data.pubDate.toISOString()}>{fecha}</time>
        <span aria-hidden="true">·</span>
        <span>{minutos} min de lectura</span>
        {
          revisado && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Revisado el <time datetime={revisado.toISOString()}>{formatoFecha(revisado)}</time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span><a href="/sobre-mi/">{NOMBRE_COMPLETO}</a> · T.P. {TARJETA_PROFESIONAL}</span>
      </p>
    </div>

    <div class="cuerpo">
      <Content />
    </div>

    <aside class="relacionados" aria-labelledby="sigue-h2">
      <h2 id="sigue-h2">Sigue por aquí</h2>
      <ul>
        {relacionados.map(([href, texto]) => <li><a href={href}>{texto}</a></li>)}
      </ul>

      {
        !paraColegas && (
          <p class="cta">
            La llamada de orientación inicial es de 20 minutos y no tiene costo.{' '}
            <a href={CAL_COM} target="_blank" rel="noopener noreferrer">
              Agéndala aquí
            </a>
            .
          </p>
        )
      }
    </aside>
  </article>
</BaseLayout>

<style>
  .articulo {
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem clamp(3rem, 7vw, 5rem);
  }

  .cabeza {
    border-top: 2px solid var(--azul-oscuro);
    padding-top: 1rem;
  }

  .rotulo {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: baseline;
  }

  .volver,
  .categoria {
    font-family: var(--fuente-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .volver {
    color: var(--azul-medio);
  }

  .categoria {
    color: var(--azul-oscuro);
  }

  h1 {
    font-family: var(--fuente-titular);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--azul-oscuro);
    text-transform: uppercase;
    margin-top: 1.75rem;
    text-wrap: balance;
  }

  .bajada {
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--azul-oscuro);
    font-weight: 600;
    margin-top: 1.25rem;
    max-width: 58ch;
    text-wrap: pretty;
  }

  .datos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    font-family: var(--fuente-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--azul-medio);
    margin-top: 1.5rem;
    border-top: 1px solid rgba(0, 51, 70, 0.2);
    padding-top: 1rem;
  }

  /* ---------- cuerpo del artículo (viene de Markdown) ---------- */

  .cuerpo {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .cuerpo :global(p) {
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--tinta-suave);
    margin-top: 1.35rem;
    text-wrap: pretty;
  }

  .cuerpo :global(h2) {
    font-family: var(--fuente-titular);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--azul-oscuro);
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 51, 70, 0.2);
    text-wrap: balance;
  }

  .cuerpo :global(h3) {
    font-family: var(--fuente-titular);
    font-stretch: 110%;
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--azul-oscuro);
    margin-top: 2.25rem;
  }

  .cuerpo :global(ul),
  .cuerpo :global(ol) {
    margin-top: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .cuerpo :global(li) {
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--tinta-suave);
    padding-left: 1.1rem;
    border-left: 2px solid var(--cian);
  }

  .cuerpo :global(ol) {
    counter-reset: paso;
  }

  .cuerpo :global(ol li) {
    counter-increment: paso;
  }

  .cuerpo :global(ol li)::before {
    content: counter(paso, decimal-leading-zero) ' ';
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--azul-medio);
    margin-right: 0.3rem;
  }

  .cuerpo :global(strong) {
    font-weight: 700;
    color: var(--azul-oscuro);
  }

  .cuerpo :global(em) {
    font-style: italic;
  }

  .cuerpo :global(a) {
    color: var(--azul-medio);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cuerpo :global(a:hover) {
    color: var(--azul-oscuro);
  }

  .cuerpo :global(hr) {
    border: none;
    border-top: 1px solid rgba(0, 51, 70, 0.25);
    margin: 2.5rem 0 0;
  }

  /* El último párrafo en cursiva de un artículo es el tagline de marca. */
  .cuerpo :global(p:last-child:has(em:only-child)) {
    font-family: var(--fuente-cuerpo);
    font-weight: 300;
    font-size: 0.95rem;
    color: var(--cian);
    margin-top: 2.75rem;
    border-top: 1px solid rgba(0, 51, 70, 0.2);
    padding-top: 1.75rem;
  }

  /* ---------- pie del artículo ---------- */

  .relacionados {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    background: var(--gris-claro);
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .relacionados h2 {
    font-family: var(--fuente-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azul-medio);
  }

  .relacionados ul {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .relacionados a {
    display: flex;
    align-items: center;
    min-height: 48px;
    color: var(--azul-oscuro);
    font-size: 0.98rem;
    border-bottom: 1px solid rgba(0, 51, 70, 0.15);
    transition:
      color 0.2s ease,
      padding-left 0.2s ease;
  }

  .relacionados a:hover {
    color: var(--azul-medio);
    padding-left: 0.4rem;
  }

  .cta {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--tinta-suave);
    margin-top: 1.5rem;
    border-top: 1px solid rgba(0, 51, 70, 0.2);
    padding-top: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .relacionados a {
      transition: none;
    }
  }
</style>
