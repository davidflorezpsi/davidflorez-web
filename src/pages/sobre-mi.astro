---
/**
 * Perfil profesional: quién atiende y cómo verificarlo.
 *
 * Las credenciales salen de credenciales.ts, que solo contiene lo que tiene
 * documento. Nunca se publica el número de cédula ni el empleador.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import retrato from '../assets/david-florez-retrato.png';
import { CREDENCIALES, FORMACION_SIN_SOPORTE } from '../data/credenciales';
import { CAL_COM } from '../data/contacto';
import { ID_PERSONA, NOMBRE_COMPLETO, TARJETA_PROFESIONAL } from '../data/identidad';

const siteUrl = Astro.site ?? 'https://davidflorez.co';
const url = new URL('/sobre-mi/', siteUrl).href;

const schema = [
  {
    '@type': 'ProfilePage',
    url,
    name: `Sobre mí · ${NOMBRE_COMPLETO}`,
    mainEntity: { '@id': ID_PERSONA },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', siteUrl).href },
      { '@type': 'ListItem', position: 2, name: 'Sobre mí', item: url },
    ],
  },
];
---

<BaseLayout
  title={`${NOMBRE_COMPLETO}, psicólogo clínico · Formación y credenciales | David Flórez`}
  description="Erwin David Flórez Rojas, psicólogo clínico (T.P. 205129), especialista en Psicología Clínica (UPB). Formación, acreditaciones ADOS-2 y ADI-R y cómo verificarlas."
  schema={schema}
>
  <article class="pagina">
    <nav class="migas" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Sobre mí</span>
    </nav>

    <header class="cabeza">
      <div class="texto">
        <p class="cejilla">Sobre mí</p>
        <h1>{NOMBRE_COMPLETO}</h1>
        <p class="cargo">Psicólogo clínico · T.P. {TARJETA_PROFESIONAL}</p>
        <p class="entrada">
          Soy especialista en Psicología Clínica. Atiendo niñez, adolescencia y adultez joven, en
          Bogotá y en línea, siempre con la familia cerca. Trabajo desde las terapias conductuales y
          contextuales —ACT, DBT, FAP, análisis funcional y entrenamiento a cuidadores—, organizadas
          con la terapia basada en procesos: cada caso empieza con una hipótesis, avanza con datos y
          termina con criterios de cierre.
        </p>
        <p>
          Estoy en clínica desde 2022, en evaluación e intervención de dificultades afectivas,
          conductuales y del neurodesarrollo. Si tu caso pide otra especialidad, te lo digo en la
          primera llamada y te remito.
        </p>
      </div>
      <div class="foto">
        <Image
          src={retrato}
          alt={`${NOMBRE_COMPLETO}, psicólogo clínico`}
          width={360}
          height={450}
          loading="eager"
        />
      </div>
    </header>

    <section aria-labelledby="formacion-h2">
      <h2 id="formacion-h2">Formación y credenciales</h2>
      <p class="nota">Cada dato corresponde a un documento original. Las acreditaciones tienen código de validación público.</p>
      <ol class="credenciales">
        {
          CREDENCIALES.map((c) => (
            <li class="credencial">
              <p class="tipo">{c.tipo} · {c.fecha}</p>
              <h3>{c.nombre}</h3>
              <p class="entidad">{c.entidad}</p>
              {c.detalle && <p class="detalle">{c.detalle}</p>}
              {c.verificacion && (
                <p class="verificar">
                  {c.verificacion.url ? (
                    <a href={c.verificacion.url} target="_blank" rel="noopener noreferrer">
                      {c.verificacion.texto}
                    </a>
                  ) : (
                    c.verificacion.texto
                  )}
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="ados-h2">
      <h2 id="ados-h2">Qué significan las acreditaciones ADOS-2 y ADI-R</h2>
      <p>
        Son formaciones clínicas dictadas con entrenadoras oficiales de cada instrumento. Preparan para
        aplicarlos y puntuarlos dentro de una evaluación clínica. Los instrumentos no diagnostican
        solos: el diagnóstico integra sus resultados con la historia del desarrollo y la información
        del colegio. <a href="/evaluacion-autismo-ados-2-bogota/">Así es la evaluación del espectro autista</a>.
      </p>
    </section>

    {
      FORMACION_SIN_SOPORTE.length > 0 && (
        <section aria-labelledby="otra-h2">
          <h2 id="otra-h2">Otra formación</h2>
          <ul class="lista">
            {FORMACION_SIN_SOPORTE.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="empezar-h2">
      <h2 id="empezar-h2">Cómo empezar</h2>
      <p>
        La llamada de orientación inicial es de 20 minutos y no tiene costo. Ahí vemos si tu caso es
        pertinente y qué servicio aplica.
      </p>
      <p class="acciones">
        <a href={CAL_COM} target="_blank" rel="noopener noreferrer" class="btn-solido" data-ubicacion="sobre_mi">
          Agendar llamada gratuita · 20 min
        </a>
        <a href="/contacto/" class="btn-linea">Contacto y sedes</a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .pagina {
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem clamp(3rem, 7vw, 5rem);
  }

  .migas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--fuente-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul-oscuro);
  }

  .migas a {
    color: var(--azul-medio);
  }

  .cabeza {
    margin-top: 1.25rem;
    border-top: 2px solid var(--azul-oscuro);
    padding-top: 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: 2rem 3rem;
    align-items: start;
  }

  @media (max-width: 760px) {
    .cabeza {
      grid-template-columns: 1fr;
    }

    .foto {
      max-width: 260px;
    }
  }

  .foto :global(img) {
    border-radius: 3px 3px 14px 14px;
    border: 1px solid rgba(0, 51, 70, 0.2);
    margin-top: 2.5rem;
  }

  h1 {
    font-family: var(--fuente-titular);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(1.9rem, 4.6vw, 3rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--azul-oscuro);
    text-transform: uppercase;
    margin-top: 1.25rem;
  }

  .cargo {
    font-family: var(--fuente-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--azul-medio);
    margin-top: 0.75rem;
  }

  .entrada {
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--azul-oscuro);
    font-weight: 600;
  }

  .texto p:not(.cejilla):not(.cargo) {
    margin-top: 1.1rem;
    max-width: 62ch;
  }

  h2 {
    font-family: var(--fuente-titular);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(1.3rem, 2.8vw, 1.8rem);
    line-height: 1.15;
    color: var(--azul-oscuro);
    margin-top: 3.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 51, 70, 0.2);
  }

  section > p {
    margin-top: 1.1rem;
    line-height: 1.8;
    max-width: 68ch;
  }

  section > p a,
  .verificar a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .credenciales {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .credencial {
    padding: 1.25rem;
    border: 1px solid rgba(0, 51, 70, 0.2);
    border-top: 3px solid var(--cian);
    border-radius: 3px 3px 12px 12px;
  }

  .tipo {
    font-family: var(--fuente-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul-oscuro);
  }

  h3 {
    font-family: var(--fuente-titular);
    font-stretch: 108%;
    font-weight: 800;
    font-size: 1.08rem;
    line-height: 1.25;
    color: var(--azul-oscuro);
    margin-top: 0.5rem;
  }

  .entidad,
  .detalle,
  .verificar {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .lista {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lista li {
    padding-left: 0.9rem;
    border-left: 2px solid var(--cian);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-solido,
  .btn-linea {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.8rem 1.35rem;
    border-radius: 999px;
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none !important;
  }

  .btn-solido {
    background: var(--azul-oscuro);
    color: #fff;
  }

  .btn-solido:hover {
    color: #fff;
  }

  .btn-linea {
    border: 1.5px solid var(--azul-oscuro);
    color: var(--azul-oscuro);
  }
</style>
