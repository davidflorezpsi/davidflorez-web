---
/**
 * Contacto y sedes: dónde se atiende presencial, qué servicios requieren ir a
 * una sede y cómo escribir o agendar, sin tener que abrir una conversación.
 *
 * Las sedes salen de SEDES (contacto.ts); qué es solo presencial se deduce de
 * los chips de cada servicio en servicios.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { PESTANAS } from '../data/servicios';
import { paginaDeServicio } from '../data/paginas-servicio';
import {
  CAL_COM,
  SEDES,
  TELEFONO_VISIBLE,
  direccionCompleta,
  enlaceMapa,
  wa,
} from '../data/contacto';
import { ID_PRACTICA, idSede } from '../data/identidad';

const siteUrl = Astro.site ?? 'https://davidflorez.co';
const url = new URL('/contacto/', siteUrl).href;

/** Servicios que no tienen modalidad telepresencial. */
const vistos = new Set<string>();
const soloPresencial = PESTANAS.flatMap((p) => p.servicios).filter((s) => {
  const presencial = s.chips.some((c) => c.startsWith('Presencial'));
  const virtual = s.chips.some((c) => c.startsWith('Telepresencial'));
  if (!presencial || virtual || vistos.has(s.titulo)) return false;
  vistos.add(s.titulo);
  return true;
});

const schema = [
  {
    '@type': 'ContactPage',
    url,
    name: 'Contacto y sedes',
    about: { '@id': ID_PRACTICA },
    mentions: SEDES.map((s) => ({ '@id': idSede(s.id) })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', siteUrl).href },
      { '@type': 'ListItem', position: 2, name: 'Contacto y sedes', item: url },
    ],
  },
];
---

<BaseLayout
  title="Contacto y sedes en Bogotá: Usaquén y Chapinero | David Flórez"
  description="Dónde atiende David Flórez, psicólogo clínico: sedes en Usaquén y Chapinero (Bogotá), atención telepresencial, WhatsApp y llamada de orientación gratuita de 20 minutos."
  schema={schema}
>
  <article class="pagina">
    <nav class="migas" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Contacto y sedes</span>
    </nav>

    <header class="cabeza">
      <p class="cejilla">Contacto · Bogotá y en línea</p>
      <h1>Contacto y sedes</h1>
      <p class="entrada">
        Atiendo presencial en dos sedes de Bogotá, en Usaquén y en Chapinero, y en modalidad
        telepresencial. Todo empieza con una llamada de orientación gratuita de 20 minutos, donde
        vemos si tu caso es pertinente para esta práctica y qué servicio aplica.
      </p>
      <div class="acciones">
        <a href={CAL_COM} target="_blank" rel="noopener noreferrer" class="btn-solido" data-ubicacion="contacto">
          Agendar llamada gratuita · 20 min
        </a>
        <a
          href={wa('Hola, escribo desde la web. Quiero orientación sobre un caso.')}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-linea"
          data-ubicacion="contacto"
        >
          WhatsApp {TELEFONO_VISIBLE}
        </a>
      </div>
    </header>

    <section aria-labelledby="sedes-h2">
      <h2 id="sedes-h2">Sedes presenciales</h2>
      <div class="sedes">
        {
          SEDES.map((s) => (
            <section class="sede" id={`sede-${s.id}`} aria-labelledby={`sede-${s.id}-h3`}>
              <h3 id={`sede-${s.id}-h3`}>{s.nombre}</h3>
              <address>
                {s.direccion}
                {s.complemento && (
                  <>
                    <br />
                    {s.complemento}
                  </>
                )}
                <br />
                {s.localidad}, Bogotá
              </address>
              <a href={enlaceMapa(s)} target="_blank" rel="noopener noreferrer" class="mapa">
                Ver en Google Maps<span class="solo-lectores">: {direccionCompleta(s)}</span>
              </a>
            </section>
          ))
        }
      </div>
      <p class="nota">La sede y el horario de cada sesión se confirman al agendar.</p>
    </section>

    <section aria-labelledby="modalidad-h2">
      <h2 id="modalidad-h2">Presencial o en línea</h2>
      <p>
        La mayoría de los servicios se pueden hacer presencial o telepresencial, según el caso y la
        edad. Estos requieren ir a una de las sedes:
      </p>
      <ul class="lista">
        {
          soloPresencial.map((s) => {
            const pagina = paginaDeServicio(s.id);
            return <li>{pagina ? <a href={`/${pagina.slug}/`}>{s.titulo}</a> : s.titulo}</li>;
          })
        }
      </ul>
      <p>
        La modalidad telepresencial está disponible para Colombia, el resto de Latinoamérica y España.
      </p>
    </section>

    <section aria-labelledby="urgencias-h2">
      <h2 id="urgencias-h2">Si es una urgencia</h2>
      <p>
        Esta es una práctica privada particular y no es un servicio de urgencias. Si hay riesgo
        inmediato para la vida o la integridad de alguien, llama a la línea 123 o acude al servicio de
        urgencias más cercano. No esperes a una cita.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .pagina {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem clamp(3rem, 7vw, 5rem);
  }

  .migas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--fuente-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul-oscuro);
  }

  .migas a {
    color: var(--azul-medio);
  }

  .cabeza {
    margin-top: 1.25rem;
    border-top: 2px solid var(--azul-oscuro);
    padding-top: 1rem;
  }

  h1 {
    font-family: var(--fuente-titular);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(1.9rem, 4.6vw, 3.1rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--azul-oscuro);
    text-transform: uppercase;
    margin-top: 1.25rem;
  }

  .entrada {
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--azul-oscuro);
    font-weight: 600;
    margin-top: 1.25rem;
    max-width: 62ch;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn-solido,
  .btn-linea {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.8rem 1.35rem;
    border-radius: 999px;
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .btn-solido {
    background: var(--azul-oscuro);
    color: #fff;
  }

  .btn-solido:hover {
    color: #fff;
  }

  .btn-linea {
    border: 1.5px solid var(--azul-oscuro);
    color: var(--azul-oscuro);
  }

  h2 {
    font-family: var(--fuente-titular);
    font-stretch: 112%;
    font-weight: 800;
    font-size: clamp(1.3rem, 2.8vw, 1.8rem);
    line-height: 1.15;
    color: var(--azul-oscuro);
    margin-top: 3.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 51, 70, 0.2);
  }

  .sedes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .sede {
    padding: 1.4rem;
    border: 1px solid rgba(0, 51, 70, 0.2);
    border-top: 3px solid var(--cian);
    border-radius: 3px 3px 12px 12px;
  }

  h3 {
    font-family: var(--fuente-titular);
    font-stretch: 110%;
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--azul-oscuro);
  }

  address {
    font-style: normal;
    margin-top: 0.6rem;
    line-height: 1.6;
    color: var(--azul-oscuro);
  }

  .mapa,
  .lista a {
    display: inline-block;
    margin-top: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lista a {
    margin-top: 0;
  }

  section > p,
  .nota {
    margin-top: 1.1rem;
    font-size: 1.02rem;
    line-height: 1.8;
    max-width: 68ch;
  }

  .lista {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lista li {
    padding-left: 0.9rem;
    border-left: 2px solid var(--cian);
  }
</style>
