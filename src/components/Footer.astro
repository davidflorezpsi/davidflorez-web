---
import { INSTAGRAM } from '../data/contacto';

const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="container fila">
    <div class="bloque">
      <p class="marca">David Flórez</p>
      <p class="descriptor">Psicología clínica infantojuvenil y adultez joven</p>
      <p class="lugar">Bogotá, Colombia · Online LatAm y España</p>
    </div>

    <div class="bloque">
      <p class="titulo-col">Psicólogo</p>
      <ul>
        <li>
          Erwin David Flórez Rojas<br />
          <span class="credencial">Psicólogo clínico · T.P. 205129</span>
        </li>
      </ul>
    </div>

    <nav aria-label="Links del pie de página">
      <a href="/privacidad" class="toque">Privacidad</a>
      <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" class="toque">Instagram</a>
    </nav>

    <p class="legal">
      © {anio} · Práctica privada particular · No es un servicio de urgencias: si hay riesgo
      inmediato, marca la línea 123
    </p>
  </div>
</footer>

<style>
  .pie {
    background: var(--azul-oscuro);
    color: #fff;
    padding: clamp(2.5rem, 5vw, 3.5rem) 0;
    border-top: 1px solid var(--cian);
  }

  .fila {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .bloque {
    flex: 1 1 260px;
    min-width: min(100%, 220px);
  }

  .marca {
    font-family: var(--fuente-titular);
    font-stretch: 115%;
    font-weight: 800;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .descriptor {
    font-family: var(--fuente-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cian);
    margin-top: 0.5rem;
  }

  .lugar {
    font-family: var(--fuente-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--hielo);
    margin-top: 0.35rem;
  }

  .titulo-col {
    font-family: var(--fuente-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cian);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 0.75rem;
  }

  li {
    font-size: 0.85rem;
    line-height: 1.4;
    color: #fff;
  }

  .credencial {
    font-family: var(--fuente-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    color: var(--hielo);
  }

  nav {
    flex: 0 1 auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  nav a {
    font-family: var(--fuente-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cian);
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: #fff;
  }

  .legal {
    flex: 1 1 100%;
    font-family: var(--fuente-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: var(--hielo);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 1.25rem;
    margin-top: 0.5rem;
  }
</style>
