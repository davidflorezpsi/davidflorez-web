---
import { INSTAGRAM, SEDES, TELEFONO_VISIBLE, wa } from '../data/contacto';
import { NOMBRE_COMPLETO, TARJETA_PROFESIONAL } from '../data/identidad';
import { PAGINAS_SERVICIO } from '../data/paginas-servicio';

const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="container fila">
    <div class="bloque">
      <p class="marca">David Flórez</p>
      <p class="descriptor">Psicología clínica infantojuvenil y adultez joven</p>
      <p class="lugar">Bogotá, Colombia · Online LatAm y España</p>
      <ul class="sedes-pie">
        {
          SEDES.map((s) => (
            <li>
              <a href={`/contacto/#sede-${s.id}`}>{s.nombre}</a>
              <br />
              <span class="credencial">
                {s.direccion}
                {s.complemento && ` · ${s.complemento}`}
              </span>
            </li>
          ))
        }
        <li>
          <a href={wa()} target="_blank" rel="noopener noreferrer" data-ubicacion="pie">
            WhatsApp {TELEFONO_VISIBLE}
          </a>
        </li>
      </ul>
    </div>

    <div class="bloque">
      <p class="titulo-col">Psicólogo</p>
      <ul>
        <li>
          {NOMBRE_COMPLETO}<br />
          <span class="credencial">Psicólogo clínico · T.P. {TARJETA_PROFESIONAL}</span>
        </li>
      </ul>
    </div>

    <nav class="bloque servicios-pie" aria-label="Servicios">
      <p class="titulo-col">Servicios</p>
      <ul>
        {PAGINAS_SERVICIO.map((p) => <li><a href={`/${p.slug}/`} class="toque">{p.nombre}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Links del pie de página">
      <a href="/sobre-mi/" class="toque">Sobre mí</a>
      <a href="/contacto/" class="toque">Contacto y sedes</a>
      <a href="/blog/" class="toque">Blog</a>
      <a href="/privacidad/" class="toque">Privacidad</a>
      <button type="button" class="toque boton-enlace" data-abrir-consentimiento>Cookies de medición</button>
      <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" class="toque">Instagram</a>
    </nav>

    <p class="legal">
      © {anio} · Práctica privada particular · No es un servicio de urgencias: si hay riesgo
      inmediato, marca la línea 123
    </p>
  </div>
</footer>

<style>
  .pie {
    background: var(--azul-oscuro);
    color: #fff;
    padding: clamp(2.5rem, 5vw, 3.5rem) 0;
    border-top: 1px solid var(--cian);
  }

  .fila {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .bloque {
    flex: 1 1 260px;
    min-width: min(100%, 220px);
  }

  .marca {
    font-family: var(--fuente-titular);
    font-stretch: 115%;
    font-weight: 800;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .descriptor {
    font-family: var(--fuente-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cian);
    margin-top: 0.5rem;
  }

  .lugar {
    font-family: var(--fuente-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--hielo);
    margin-top: 0.35rem;
  }

  .titulo-col {
    font-family: var(--fuente-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cian);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 0.75rem;
  }

  li {
    font-size: 0.85rem;
    line-height: 1.4;
    color: #fff;
  }

  .sedes-pie a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .credencial {
    font-family: var(--fuente-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    color: var(--hielo);
  }

  nav {
    flex: 0 1 auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  nav a {
    font-family: var(--fuente-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cian);
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: #fff;
  }

  .boton-enlace {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
    font-family: var(--fuente-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cian);
  }

  .boton-enlace:hover {
    color: #fff;
  }

  .servicios-pie a {
    font-family: var(--fuente-cuerpo);
    font-size: 0.85rem;
    letter-spacing: 0;
    text-transform: none;
    color: #fff;
  }

  .servicios-pie a:hover {
    color: var(--cian);
  }

  .legal {
    flex: 1 1 100%;
    font-family: var(--fuente-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: var(--hielo);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 1.25rem;
    margin-top: 0.5rem;
  }
</style>
