---
/**
 * Google Analytics 4 con modo de consentimiento.
 *
 * Por defecto todo va denegado: GA no guarda cookies ni identificadores hasta
 * que la persona acepta en el aviso (Consentimiento.astro). Sin consentimiento
 * GA solo recibe señales sin cookies, que no identifican a nadie. Publicidad:
 * siempre denegada, el sitio no la usa.
 */
---
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}

  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
  });
  try {
    if (localStorage.getItem('consentimiento-analitica') === 'si') {
      gtag('consent', 'update', { analytics_storage: 'granted' });
    }
  } catch (_) {}

  gtag('js', new Date());
  gtag('config', 'G-6X804BXQQ9');

  /*
   * Embudo de captación:
   *   contact_click     → clic a WhatsApp (interés inicial; no es una consulta)
   *   booking_click     → clic a la agenda de la llamada gratuita
   *   booking_confirmed → llamada agendada: Cal.com redirige a /gracias/
   *   payment_click     → clic a un link de pago de Wompi (intención de pago;
   *                       el pago confirmado solo lo sabe Wompi)
   *   quiz_complete     → filtro de pertinencia terminado (Pertinencia.astro)
   * Parámetros: canal, ubicación del botón y página; en el filtro, solo si
   * encaja o no. Nunca el texto prellenado, el nombre, el monto ni las
   * respuestas del filtro. Marcar como eventos clave en GA4.
   */
  document.addEventListener('click', function (e) {
    var a = e.target instanceof Element ? e.target.closest('a[href]') : null;
    if (!a) return;
    var url;
    try { url = new URL(a.href); } catch (_) { return; }

    var evento, canal;
    if (url.hostname === 'wa.me' || url.hostname.endsWith('whatsapp.com')) {
      evento = 'contact_click'; canal = 'whatsapp';
    } else if (url.hostname === 'cal.com') {
      evento = 'booking_click'; canal = 'cal_com';
    } else if (url.hostname === 'checkout.wompi.co') {
      evento = 'payment_click'; canal = 'wompi';
    } else {
      return;
    }

    var seccion = a.closest('section[id], header, footer, nav, aside');
    var ubicacion = a.dataset.ubicacion
      || (seccion && (seccion.id || seccion.tagName.toLowerCase()))
      || 'sin_ubicacion';

    gtag('event', evento, {
      canal: canal,
      ubicacion: ubicacion,
      pagina: location.pathname,
      transport_type: 'beacon',
    });
  });
</script>
<script is:inline>
  /*
   * Google tag llega después de la carga: es el archivo más pesado del sitio
   * (176 KB) y competía con el primer pintado (PageSpeed, 20 de octubre de 2026).
   * Los comandos de arriba esperan en dataLayer y gtag.js los procesa al llegar.
   * /gracias/ lo pide de inmediato con window.cargarGoogleTag().
   */
  (function () {
    var cargado = false;
    function cargar() {
      if (cargado) return;
      cargado = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-6X804BXQQ9';
      document.head.appendChild(s);
    }
    window.cargarGoogleTag = cargar;
    addEventListener('load', function () {
      if (window.requestIdleCallback) requestIdleCallback(cargar, { timeout: 2000 });
      else setTimeout(cargar, 0);
    });
  })();
</script>
