---
/**
 * 11 / Últimas publicaciones — las cuatro más recientes de @ps.davidflorez.
 *
 * Se leen en el build con la API oficial (src/lib/instagram.ts) y las imágenes
 * se sirven desde este dominio: ni scripts ni cookies de Meta en la página.
 * Si no hay token o la API falla, la sección queda en un enlace al perfil, sin
 * casillas vacías.
 */
import { Image } from 'astro:assets';
import { INSTAGRAM } from '../../data/contacto';
import { publicacionesInstagram } from '../../lib/instagram';

const publicaciones = await publicacionesInstagram(4);
---

<section class="instagram" aria-labelledby="instagram-h2">
  <div class="container">
    <h2 id="instagram-h2" class="solo-lectores">Últimas publicaciones en Instagram</h2>

    <div class="cab">
      <span class="cejilla-cyan">11 / Últimas publicaciones</span>
      <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" class="toque">@ps.davidflorez ↗</a>
    </div>

    {
      publicaciones.length > 0 ? (
        <ul class="rejilla">
          {publicaciones.map((p) => (
            <li class="casilla">
              <a href={p.enlace} target="_blank" rel="noopener noreferrer">
                <Image
                  src={p.imagen}
                  alt={p.alt}
                  inferSize
                  widths={[320, 640]}
                  sizes="(min-width: 900px) 25vw, 50vw"
                  loading="lazy"
                  decoding="async"
                />
                <span class="solo-lectores"> (se abre en Instagram)</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer" class="perfil">
          <span>Ver las publicaciones en Instagram</span>
          <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</section>

<style>
  .instagram {
    background: var(--azul-oscuro);
    padding: clamp(3rem, 6vw, 4.5rem) 0;
  }

  .cab {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: baseline;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    padding-top: 1rem;
  }

  .cejilla-cyan {
    font-family: var(--fuente-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cian);
  }

  .cab a {
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: #fff;
  }

  .cab a:hover {
    color: var(--cian);
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0;
    margin-top: 2rem;
    border-left: 1px solid rgba(255, 255, 255, 0.3);
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }

  .casilla {
    aspect-ratio: 4 / 5;
    border-right: 1px solid rgba(255, 255, 255, 0.3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    overflow: hidden;
  }

  .casilla a {
    display: block;
    height: 100%;
  }

  .casilla img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.4s var(--salida),
      opacity 0.3s ease;
  }

  .casilla a:hover img,
  .casilla a:focus-visible img {
    transform: scale(1.03);
    opacity: 0.9;
  }

  .casilla a:focus-visible {
    outline: 2px solid var(--cian);
    outline-offset: -2px;
  }

  .perfil {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-family: var(--fuente-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .perfil:hover {
    background: var(--cian);
    color: var(--azul-oscuro);
  }

  @media (prefers-reduced-motion: reduce) {
    .casilla img,
    .perfil {
      transition: none;
    }
  }
</style>
