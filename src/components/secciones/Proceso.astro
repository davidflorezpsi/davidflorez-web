---
/**
 * 07 / El proceso — cinco tramos y una brújula que apunta al paso en pantalla.
 *
 * La aguja gira calculando el ángulo entre el centro del SVG y el centro del
 * paso activo; el paso activo se decide por cercanía al 48% del viewport.
 */
const PASOS = [
  {
    n: '01',
    titulo: 'Llamada de orientación inicial',
    nota: 'Gratuita · 20 minutos · Virtual',
    texto:
      'Conversamos sobre las dificultades de tu hijo o hija, evaluamos si el caso es pertinente para esta práctica y determinamos qué servicio aplica. Sin compromiso por ninguna parte.',
  },
  {
    n: '02',
    titulo: 'Decisión de proceder',
    nota: 'Se confirma la idoneidad clínica',
    texto:
      'Si el caso es pertinente y decides iniciar, el profesional confirma la idoneidad clínica y se define el servicio a contratar.',
  },
  {
    n: '03',
    titulo: 'Pago del servicio',
    nota: 'Anticipado · Stripe o Mi Llave',
    texto:
      'Pago anticipado requerido para habilitar el calendario de sesiones. Medios disponibles: tarjeta de crédito o débito internacional vía Stripe · pagos nacionales vía Mi Llave.',
  },
  {
    n: '04',
    titulo: 'Calendario y consentimiento informado',
    nota: 'Acceso digital tras el pago',
    texto:
      'Tras la confirmación del pago recibes acceso al calendario de sesiones y al formulario de consentimiento informado digital.',
  },
  {
    n: '05',
    titulo: 'Inicio del proceso clínico',
    nota: 'Objetivos definidos, progreso medible',
    texto: 'Primera sesión agendada. Proceso estructurado, objetivos definidos, progreso medible.',
  },
];

const MARCAS = [
  'M160 44 L160 32', 'M218 59.5 L224 49.2', 'M260.5 102 L270.8 96',
  'M276 160 L288 160', 'M260.5 218 L270.8 224', 'M218 260.5 L224 270.8',
  'M160 276 L160 288', 'M102 260.5 L89.2 270.8', 'M59.5 218 L49.2 224',
  'M44 160 L32 160', 'M59.5 102 L49.2 96', 'M102 59.5 L89.2 49.2',
];
---

<section id="proceso" class="proceso">
  <div class="container">
    <div class="rotulo"><span class="cejilla">07 / El proceso</span></div>

    <div class="intro">
      <h2>¿Cómo<br />empezamos?</h2>
      <p>
        Una brújula no avanza por ti: en cada paso confirma la dirección. Cinco tramos, y el primero
        no cuesta nada.
      </p>
    </div>

    <div class="cuerpo">
      <div class="brujula-col">
        <svg
          id="brujula-svg"
          viewBox="0 0 320 320"
          width="100%"
          role="img"
          aria-label="Brújula que apunta al paso actual del proceso"
        >
          <circle cx="160" cy="160" r="150" fill="none" stroke="#003346" stroke-width="1" opacity="0.35"
          ></circle>
          <circle cx="160" cy="160" r="132" fill="none" stroke="#003346" stroke-width="1.5"></circle>
          <circle cx="160" cy="160" r="104" fill="none" stroke="#05a3d4" stroke-width="1" stroke-dasharray="3 7"
          ></circle>

          <g stroke="#003346" stroke-width="1.5" opacity="0.55">
            {MARCAS.map((d) => <path d={d} />)}
          </g>

          <path d="M160 16 L160 304" stroke="#003346" stroke-width="1" opacity="0.2"></path>
          <path d="M16 160 L304 160" stroke="#003346" stroke-width="1" opacity="0.2"></path>
          <text
            x="160"
            y="84"
            text-anchor="middle"
            font-family="IBM Plex Mono, monospace"
            font-size="13"
            letter-spacing="2"
            fill="#003346"
            opacity="0.5">N</text
          >

          <g id="brujula-aguja">
            <path d="M160 52 L184 168 L160 146 L136 168 Z" fill="#05a3d4"></path>
            <path d="M160 268 L136 152 L160 174 L184 152 Z" fill="none" stroke="#003346" stroke-width="1.5"
            ></path>
          </g>

          <circle cx="160" cy="160" r="8" fill="#fff" stroke="#003346" stroke-width="2.5"></circle>
        </svg>

        <div class="brujula-pie">
          <p class="paso-n" id="paso-indicador">Paso 1 de 5</p>
          <p class="paso-t" id="paso-titulo">Llamada de orientación inicial</p>
        </div>
      </div>

      <ol class="lista">
        {
          PASOS.map((p, i) => (
            <li id={`paso-${i + 1}`} class="tramo">
              <button type="button" class="tramo-cab" data-paso={i + 1} aria-expanded="false" aria-controls={`paso-p${i + 1}`}>
                <span class="tramo-n">{p.n}</span>
                <span class="tramo-texto">
                  <span class="tramo-titulo">{p.titulo}</span>
                  <span class="tramo-nota">{p.nota}</span>
                </span>
                <span class="tramo-ico">+</span>
              </button>
              <div class="tramo-panel" id={`paso-p${i + 1}`} hidden>
                <p>{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .proceso {
    position: relative;
    background: #fff;
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    overflow: hidden;
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 2.5rem;
    align-items: flex-end;
    justify-content: space-between;
  }

  .intro h2 {
    font-family: var(--fuente-titular);
    font-stretch: 115%;
    font-weight: 800;
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--azul-oscuro);
    text-transform: uppercase;
  }

  .intro p {
    flex: 1 1 380px;
    max-width: 52ch;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--azul-oscuro);
    font-weight: 600;
    text-wrap: pretty;
  }

  .cuerpo {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: 3rem;
    align-items: flex-start;
  }

  .brujula-col {
    flex: 0 1 330px;
    min-width: min(100%, 260px);
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  #brujula-svg {
    max-width: 330px;
  }

  #brujula-aguja {
    transform-origin: 160px 160px;
    transition: transform 0.75s var(--salida);
  }

  .brujula-pie {
    text-align: center;
    border-top: 1px solid var(--azul-oscuro);
    padding-top: 1rem;
    width: 100%;
    max-width: 280px;
  }

  .paso-n {
    font-family: var(--fuente-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--azul-medio);
  }

  .paso-t {
    font-family: var(--fuente-titular);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1.2;
    color: var(--azul-oscuro);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-top: 0.5rem;
  }

  .lista {
    flex: 1 1 420px;
    min-width: min(100%, 300px);
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--azul-oscuro);
  }

  .tramo {
    border-bottom: 1px solid var(--azul-oscuro);
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.55s ease,
      transform 0.55s var(--salida),
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  .tramo[data-visible] {
    opacity: 1;
    transform: none;
  }

  /* El paso en pantalla se resalta con una guía cyan a la izquierda. */
  .tramo[data-activo] {
    background: var(--gris-claro);
    box-shadow: inset 4px 0 0 var(--cian);
  }

  .tramo-cab {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    padding: 1.6rem 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  /* Sobre blanco y sobre #ececec el cian no llega al minimo: ver .ico en Faq. */
  .tramo-n {
    font-family: var(--fuente-titular);
    font-stretch: 118%;
    font-weight: 900;
    font-size: 1.7rem;
    line-height: 0.9;
    color: var(--azul-medio);
    flex: 0 0 auto;
  }

  .tramo-texto {
    flex: 1;
  }

  .tramo-titulo {
    display: block;
    font-family: var(--fuente-titular);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1.2;
    color: var(--azul-oscuro);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .tramo-nota {
    display: block;
    font-family: var(--fuente-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul-medio);
    margin-top: 0.4rem;
  }

  .tramo-ico {
    color: var(--azul-medio);
    font-size: 1.4rem;
    line-height: 1;
  }

  .tramo-panel {
    padding: 0 1.25rem 1.6rem 4.1rem;
  }

  .tramo-panel[hidden] {
    display: none;
  }

  .tramo-panel p {
    font-size: 0.95rem;
    line-height: 1.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .tramo {
      opacity: 1;
      transform: none;
      transition: none;
    }

    #brujula-aguja {
      transition: none;
    }
  }
</style>

<script>
  const TITULOS = [
    'Llamada de orientación inicial',
    'Decisión de proceder',
    'Pago del servicio',
    'Calendario y consentimiento',
    'Inicio del proceso clínico',
  ];

  let activo = 1;

  const alScroll = () => {
    const vh = window.innerHeight || 800;
    const centro = vh * 0.48;
    let nuevo = 0;
    let mejor = Infinity;

    for (let i = 1; i <= 5; i++) {
      const li = document.getElementById(`paso-${i}`);
      if (!li) continue;
      const r = li.getBoundingClientRect();
      const d = Math.abs(r.top + r.height / 2 - centro);
      if (r.bottom > 0 && r.top < vh && d < mejor) {
        mejor = d;
        nuevo = i;
      }
    }

    if (nuevo) {
      for (let i = 1; i <= 5; i++) {
        const li = document.getElementById(`paso-${i}`);
        if (!li) continue;
        if (i === nuevo) li.setAttribute('data-activo', '');
        else li.removeAttribute('data-activo');
      }
      if (nuevo !== activo) {
        activo = nuevo;
        const ind = document.getElementById('paso-indicador');
        const tit = document.getElementById('paso-titulo');
        if (ind) ind.textContent = `Paso ${activo} de 5`;
        if (tit) tit.textContent = TITULOS[activo - 1];
      }
    }

    // La aguja apunta al centro del paso activo.
    const svg = document.getElementById('brujula-svg');
    const aguja = document.getElementById('brujula-aguja');
    const objetivo = document.getElementById(`paso-${nuevo || activo}`);
    if (svg && aguja && objetivo) {
      const c = svg.getBoundingClientRect();
      const t = objetivo.getBoundingClientRect();
      const dx = t.left + t.width / 2 - (c.left + c.width / 2);
      const dy = t.top + t.height / 2 - (c.top + c.height / 2);
      aguja.style.transform = `rotate(${(Math.atan2(dy, dx) * 180) / Math.PI + 90}deg)`;
    }
  };

  // Entrada de cada tramo: por IntersectionObserver, para que también aparezcan
  // al entrar directo a #proceso, donde no llega ningún evento de scroll.
  const tramos = [...document.querySelectorAll<HTMLElement>('#proceso .tramo')];
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.setAttribute('data-visible', '');
          obs.unobserve(e.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    tramos.forEach((el) => obs.observe(el));
  } else {
    tramos.forEach((el) => el.setAttribute('data-visible', ''));
  }

  document.querySelectorAll<HTMLButtonElement>('.tramo-cab[data-paso]').forEach((b) => {
    b.addEventListener('click', () => {
      const panel = document.getElementById(`paso-p${b.dataset.paso}`);
      if (!panel) return;
      const abierto = !panel.hidden;
      panel.hidden = abierto;
      b.setAttribute('aria-expanded', String(!abierto));
      const ico = b.querySelector('.tramo-ico');
      if (ico) ico.textContent = abierto ? '+' : '−';
    });
  });

  window.addEventListener('scroll', alScroll, { passive: true });
  window.addEventListener('resize', alScroll, { passive: true });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') alScroll();
  });
  alScroll();
</script>
