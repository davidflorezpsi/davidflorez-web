---
/**
 * 10 / Primer paso — la llamada de orientación (opcional) y WhatsApp.
 *
 * Cómo se reserva y se paga ya está en 07 / El proceso; aquí no se repite.
 * El aviso de que el pago solo se hace en Wompi vive en Servicios y en /pagar/.
 */
import { CAL_COM, wa } from '../../data/contacto';
import Compartir from '../Compartir.astro';
---

<section id="agenda" class="agenda">
  <div class="container">
    <div class="cabeza">
      <div class="cabeza-texto">
        <span class="cejilla-navy">10 / Primer paso</span>
        <h2>Agenda tu llamada de orientación gratuita</h2>
        <p>
          20 minutos, sin costo y opcional, para resolver dudas antes de decidir. Si ya sabes qué
          servicio necesitas, escríbeme por WhatsApp y te envío el link de pago.
        </p>
      </div>

      <div class="cabeza-acciones">
        <a href={CAL_COM} target="_blank" rel="noopener noreferrer" class="btn-solido">
          <span>Ver horarios disponibles</span><span>↗</span>
        </a>
        <a href={wa()} target="_blank" rel="noopener noreferrer" class="btn-linea">
          <span>Escribir por WhatsApp</span><span>↗</span>
        </a>
        <p class="letra-chica">Máx. 1 llamada por familia · Sin costo · Sin compromiso</p>
      </div>
    </div>

    <div class="pie-agenda">
      <Compartir />
    </div>
  </div>
</section>

<style>
  .agenda {
    background: var(--cian);
    padding: clamp(4rem, 7vw, 5.5rem) 0;
  }

  .cabeza {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    justify-content: space-between;
  }

  .cabeza-texto {
    flex: 1 1 440px;
    min-width: min(100%, 300px);
  }

  .cejilla-navy {
    font-family: var(--fuente-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--azul-oscuro);
  }

  h2 {
    font-family: var(--fuente-titular);
    font-stretch: 118%;
    font-weight: 900;
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--azul-oscuro);
    text-transform: uppercase;
    margin-top: 1rem;
  }

  .cabeza-texto p {
    color: var(--azul-oscuro);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-top: 1.25rem;
    max-width: 46ch;
    font-weight: 600;
  }

  .cabeza-acciones {
    flex: 0 1 320px;
    min-width: min(100%, 280px);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .btn-solido,
  .btn-linea {
    padding: 1.15rem 1.75rem;
    font-family: var(--fuente-mono);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .btn-solido {
    background: var(--azul-oscuro);
    color: #fff;
  }

  .btn-solido:hover {
    background: #fff;
    color: var(--azul-oscuro);
  }

  .btn-linea {
    border: 1px solid var(--azul-oscuro);
    color: var(--azul-oscuro);
  }

  .btn-linea:hover {
    background: var(--azul-oscuro);
    color: #fff;
  }

  .letra-chica {
    font-family: var(--fuente-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--azul-oscuro);
    margin-top: 1rem;
  }

  /* Compartir ya trae su propia línea superior. */
  .pie-agenda {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
