---
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { grafoBase, DESCRIPCION_PRACTICA } from '../data/identidad';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/nunito/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Propiedades extra para la ficha de la práctica (la home añade el catálogo). */
  extraPractica?: Record<string, unknown>;
  /** Nodos de schema propios de la página (BreadcrumbList, Service, BlogPosting…). */
  schema?: Record<string, unknown>[];
}

const {
  title = 'David Flórez | Psicólogo Clínico Infantojuvenil y Adultez Joven | Bogotá',
  description = DESCRIPCION_PRACTICA,
  ogImage = '/og-image.png',
  extraPractica = {},
  schema = [],
} = Astro.props;

const siteUrl = Astro.site ?? 'https://davidflorez.co';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(ogImage, siteUrl);

/**
 * Un solo grafo por página: web, persona y práctica en todas (así el autor de
 * un artículo o el proveedor de un servicio resuelven a una entidad definida
 * en el mismo documento), más los nodos propios de cada página.
 */
const grafo = {
  '@context': 'https://schema.org',
  '@graph': [...grafoBase(extraPractica), ...schema],
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="X6LlRpoC0Dx-ozdN4zRLiFgLaGkoYV0ghyvEbtjSiMY" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Las fuentes se sirven desde el propio dominio. Se precargan las dos que
      pinta la primera pantalla (titular y cuerpo, subconjunto latino); la mono
      es pequeña y llega con font-display: swap.
    -->
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Psicología clínica basada en procesos — David Flórez, psicólogo clínico, Bogotá" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="David Flórez · Psicólogo Clínico" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(grafo)} />

    <Analytics />
  </head>
  <body>
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Visible solo al tabular: primer destino del teclado. */
  .saltar {
    position: fixed;
    top: 0.85rem;
    left: 50%;
    transform: translate(-50%, -150%);
    z-index: 200;
    background: var(--azul-oscuro);
    color: #fff;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: transform 0.2s var(--salida);
  }

  .saltar:focus {
    transform: translate(-50%, 0);
    color: #fff;
  }
</style>
