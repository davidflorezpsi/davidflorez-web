---
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { WHATSAPP, CAL_COM, INSTAGRAM } from '../data/contacto';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Los datos estructurados solo tienen sentido en la home. */
  datosEstructurados?: boolean;
}

const {
  title = 'David Flórez | Psicólogo Clínico Infantojuvenil y Adultez Joven | Bogotá',
  description = 'Psicología clínica basada en procesos para niñez, adolescencia y adultez joven. Evaluación e intervención con objetivos y progreso medible. Bogotá y online.',
  ogImage = '/og-image.png',
  datosEstructurados = false,
} = Astro.props;

const siteUrl = Astro.site ?? 'https://davidflorez.co';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(ogImage, siteUrl);

/**
 * Ficha de la práctica para buscadores. Psychologist es un subtipo de
 * MedicalBusiness: describe quién atiende, dónde, a quién y con qué servicios.
 */
const fichaNegocio = {
  '@context': 'https://schema.org',
  '@type': 'Psychologist',
  '@id': `${siteUrl}#practica`,
  name: 'Erwin David Flórez Rojas — Psicología Clínica',
  alternateName: 'David Flórez · Psicólogo Clínico',
  url: String(siteUrl),
  image: String(ogImageURL),
  description,
  telephone: `+${WHATSAPP}`,
  priceRange: '$390.000 – $2.750.000 COP',
  currenciesAccepted: 'COP',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bogotá',
    addressCountry: 'CO',
  },
  areaServed: [
    { '@type': 'City', name: 'Bogotá' },
    { '@type': 'Country', name: 'Colombia' },
    { '@type': 'Place', name: 'Latinoamérica y España (online)' },
  ],
  availableLanguage: 'es',
  sameAs: [INSTAGRAM],
  founder: {
    '@type': 'Person',
    name: 'Erwin David Flórez Rojas',
    jobTitle: 'Psicólogo clínico',
    identifier: 'T.P. 205129',
    knowsAbout: [
      'Terapia Basada en Procesos (PBT)',
      'Terapia de Aceptación y Compromiso (ACT)',
      'Terapia Dialéctica Conductual (DBT)',
      'Psicoterapia Analítico Funcional (FAP)',
      'Entrenamiento conductual a cuidadores',
      'PEERS · Habilidades sociales',
      'ADOS-2 y ADI-R · Evaluación del espectro autista',
    ],
  },
  potentialAction: {
    '@type': 'ReserveAction',
    name: 'Llamada de orientación gratuita de 20 minutos',
    target: CAL_COM,
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios clínicos',
    itemListElement: [
      ['Evaluación Funcional Clínica', 'Proceso estructurado de 3 sesiones, con análisis funcional e informe', '390000'],
      ['Evaluación del espectro autista · ADOS-2 / ADI-R', '6 sesiones, incluye protocolos', '1050000'],
      ['Programa de Intervención Individual · niñez y adolescencia', '16 sesiones, 4 sesiones con cuidadores y una asesoría al colegio', '2750000'],
      ['Programa de Intervención Individual · jóvenes adultos', 'Ciclo de 16 sesiones con criterios de cierre', '2080000'],
      ['Entrenamiento conductual a cuidadores', 'Ciclo de 8 sesiones con práctica en vivo y registro diario', '1040000'],
      ['PEERS · Habilidades sociales', 'Ciclo de 14 sesiones en grupo, por adolescente', '1400000'],
      ['Coaching parental', 'Sesiones con cuidadores, número acordado en la llamada', '130000'],
    ].map(([nombre, desc, precio]) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: nombre, description: desc },
      price: precio,
      priceCurrency: 'COP',
    })),
  },
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="X6LlRpoC0Dx-ozdN4zRLiFgLaGkoYV0ghyvEbtjSiMY" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Las fuentes se piden desde el <head>, no con @import dentro del CSS:
      el @import encadena HTML → CSS → CSS de fuentes → archivos de fuente,
      y retrasa el primer pintado.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500;600&family=Nunito:wght@400;600;700;800&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Psicología clínica basada en procesos — David Flórez, psicólogo clínico, Bogotá" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="David Flórez · Psicólogo Clínico" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {
      datosEstructurados && (
        <script type="application/ld+json" set:html={JSON.stringify(fichaNegocio)} />
      )
    }

    <Analytics />
  </head>
  <body>
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Visible solo al tabular: primer destino del teclado. */
  .saltar {
    position: fixed;
    top: 0.85rem;
    left: 50%;
    transform: translate(-50%, -150%);
    z-index: 200;
    background: var(--azul-oscuro);
    color: #fff;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: transform 0.2s var(--salida);
  }

  .saltar:focus {
    transform: translate(-50%, 0);
    color: #fff;
  }
</style>
